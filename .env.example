# Urban Noise Monitoring & Complaint Management System
# Root Environment Template (All Secrets Kept in Platform Dashboards)

NODE_ENV=production

# Backend Service Configuration (Render)
PORT=10000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/urban_noise_db?retryWrites=true&w=majority&appName=Cluster0
REDIS_URL=
JWT_SECRET=your_long_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://your-frontend-app.vercel.app

# Simulation Configuration
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_MS=8000

# Frontend Service Configuration (Vercel)
VITE_API_BASE_URL=https://your-backend-app.onrender.com/api
