# Backend Environment Variables Template (Render)
NODE_ENV=production
PORT=10000

# MongoDB Atlas Connection URI (Replace with your actual Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/urban_noise_db?retryWrites=true&w=majority&appName=Cluster0

# Redis URL (Optional: Leave blank or provide redis://... if using cloud Redis; application falls back gracefully if not set)
REDIS_URL=

# JWT Authentication Secret
JWT_SECRET=your_long_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (Vercel URL and localhost; can be comma-separated)
CORS_ORIGIN=https://your-frontend-app.vercel.app,http://localhost:5174

# Sensor Telemetry Simulation Settings
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_MS=8000
